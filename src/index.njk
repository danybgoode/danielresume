---
title: Daniel Vásquez — Product & Agentic Delivery
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ resume.en.ui.pageTitle }}</title>
<meta name="description" content="{{ resume.en.ui.metaDesc }}">
<meta name="author" content="Daniel Vásquez">
<meta name="robots" content="index, follow">
<meta name="theme-color" content="#FAFAF8">

<!-- Favicons -->
<link rel="icon" type="image/png" href="/cauldron.png">
<link rel="shortcut icon" href="/cauldron.png">
<link rel="apple-touch-icon" href="/cauldron.png">

<!-- Canonical & Multilingual -->
<link rel="canonical" href="https://danielresume.vercel.app/">
<link rel="alternate" hreflang="en" href="https://danielresume.vercel.app/">
<link rel="alternate" hreflang="es" href="https://danielresume.vercel.app/">
<link rel="alternate" hreflang="x-default" href="https://danielresume.vercel.app/">

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ resume.en.ui.pageTitle }}">
<meta property="og:description" content="{{ resume.en.ui.metaDesc }}">
<meta property="og:url" content="https://danielresume.vercel.app/">
<meta property="og:site_name" content="Daniel Vásquez">
<meta property="og:image" content="https://danielresume.vercel.app/cauldron.png">
<meta property="og:image:alt" content="Daniel Vásquez — Hands-on Product Leader">
<meta property="og:locale" content="en_US">
<meta property="og:locale:alternate" content="es_MX">

<!-- Twitter / X -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ resume.en.ui.pageTitle }}">
<meta name="twitter:description" content="{{ resume.en.ui.metaDesc }}">
<meta name="twitter:image" content="https://danielresume.vercel.app/cauldron.png">
<meta name="twitter:image:alt" content="Daniel Vásquez — Hands-on Product Leader">

<!-- Structured Data (JSON-LD).
     The visible Capabilities tag-cloud is gone, but keyword matching has not
     — recruiters' tooling and LLM readers both mine knowsAbout. This is where
     the skill keywords live now: machine-readable, not a wall of pills. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Daniel Vásquez",
  "jobTitle": "Product Engineering Leader",
  "description": "Hands-on product leader available for contract and fractional engagements: turns a clear strategy into shipped, measured product with engineers and their agents.",
  "url": "https://danielresume.vercel.app",
  "email": "mailto:danielvp1987@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mexico City",
    "addressCountry": "MX"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of Aberdeen"
  },
  "knowsAbout": [
    "Product Management",
    "Product Strategy",
    "Product Engineering",
    "Multi-Agent Orchestration",
    "AI Agents",
    "LLM Application Development",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
    "Engineering Leadership",
    "Organization Design",
    "Agile and Scrum",
    "Platform Engineering",
    "Marketplace Design",
    "Payments and Checkout",
    "E-commerce",
    "Experimentation and A/B Testing",
    "Feature Flags",
    "Product Analytics",
    "System Architecture",
    "Next.js",
    "TypeScript",
    "Supabase and PostgreSQL",
    "Google Cloud Run",
    "CI/CD",
    "Financial Modeling",
    "M&A Integration"
  ],
  "sameAs": [
    "https://www.linkedin.com/in/danielvasquezparedes",
    "https://github.com/danybgoode",
    "https://goldenfrijoles.com",
    "https://miyagisanchez.com"
  ]
}
</script>

<link rel="preload" href="/fonts/PaperMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="page">

  <header class="masthead">
    <div class="masthead-top">
      <div class="view-switch" role="tablist" aria-label="{{ resume.en.ui.viewsLabel }}" id="viewSwitch">
        <button type="button" role="tab" id="tab-work" class="view-tab" aria-selected="true" aria-controls="workView" data-view="work">{{ resume.en.ui.workButton }}</button>
        <button type="button" role="tab" id="tab-classic" class="view-tab" aria-selected="false" aria-controls="classicView" data-view="classic" tabindex="-1">{{ resume.en.ui.classicButton }}</button>
        <button type="button" role="tab" id="tab-tldr" class="view-tab" aria-selected="false" aria-controls="tldrView" data-view="tldr" tabindex="-1">{{ resume.en.ui.tldrButton }}</button>
      </div>
      <div class="header-actions">
        <a id="cvLink" class="cv-btn" href="{{ resume.en.ui.cvFile }}" download>
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="cv-long" id="cvLong">{{ resume.en.ui.cvButton }}</span><span class="cv-short" id="cvShort" aria-hidden="true">{{ resume.en.ui.cvButtonShort }}</span>
          <span class="file-tag">PDF</span>
        </a>
        <div class="lang-switch" role="group" aria-label="Language selector">
          <button type="button" class="lang-btn is-active" id="langBtnEn" data-lang="en" aria-pressed="true">EN</button>
          <span class="lang-divider" aria-hidden="true">/</span>
          <button type="button" class="lang-btn" id="langBtnEs" data-lang="es" aria-pressed="false">ES</button>
        </div>
      </div>
    </div>
  </header>

  <!-- WORK WITH ME VIEW (default). Both languages are rendered server-side and
       the language switch only toggles which block is visible, so this view
       needs no client-side templating and reads fine with JS off. -->
  <main id="workView" class="view-container work-view" role="tabpanel" aria-labelledby="tab-work" tabindex="-1">
    {% for lang in ["en", "es"] %}
    {% set d = resume[lang] %}
    {% set w = d.work %}
    <div class="lang-block" data-lang-block="{{ lang }}" lang="{{ lang }}"{% if lang != "en" %} hidden{% endif %}>

      <div class="work-hero">
        <h1 class="work-headline">{{ w.headline }}</h1>
        <p class="work-lede">{{ w.lede }}</p>
      </div>

      <section class="work-section offers" aria-labelledby="offers-{{ lang }}">
        <h2 class="work-h2" id="offers-{{ lang }}">{{ w.offersTitle }}</h2>
        {% for o in w.offers %}
        <article class="offer">
          <h3 class="offer-title">{{ o.title }}</h3>
          <p class="offer-body">{{ o.body }}</p>
          <p class="offer-shape">{{ o.shape }}</p>
        </article>
        {% endfor %}
      </section>

      <section class="work-section" aria-labelledby="includes-{{ lang }}">
        <h2 class="work-h2" id="includes-{{ lang }}">{{ w.includesTitle }}</h2>
        <ul class="includes">
          {% for i in w.includes %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </section>

      <section class="work-section method" aria-labelledby="method-{{ lang }}">
        <h2 class="work-h2" id="method-{{ lang }}">{{ w.methodTitle }}</h2>
        <p class="method-headline">{{ w.methodHeadline }}</p>
        <p class="work-prose">{{ w.methodBody }}</p>
        <ol class="method-steps">
          {% for s in w.methodSteps %}
          <li><span class="step-name">{{ s.name }}</span><span class="step-text">{{ s.text }}</span></li>
          {% endfor %}
        </ol>
        <p class="method-link"><a href="{{ d.links.methodology.url }}" target="_blank" rel="noopener noreferrer">{{ w.methodLink }}</a> <span class="link-host">goldenfrijoles.com</span></p>
      </section>

      <section class="work-section contact" aria-labelledby="contact-{{ lang }}">
        <h2 class="work-h2" id="contact-{{ lang }}">{{ w.contactTitle }}</h2>
        <p class="work-prose">{{ w.contactBody }}</p>
        <div class="email-row">
          <a class="email-big" href="mailto:{{ d.email }}">{{ d.email }}</a>
          <button type="button" class="copy-btn" data-copy="{{ d.email }}" data-label-copy="{{ w.copy }}" data-label-copied="{{ w.copied }}" aria-label="{{ w.copyLabel }}">
            <svg class="i-copy" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            <svg class="i-check" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="copy-text">{{ w.copy }}</span>
          </button>
          <span class="sr-only copy-status" aria-live="polite"></span>
        </div>
        <p class="contact-links">
          <a href="{{ d.links.linkedin.url }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="{{ d.ui.cvFile }}" download>{{ w.ctaCv }} <span class="file-tag">PDF</span></a>
          <a href="{{ d.links.github.url }}" target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </section>

    </div>
    {% endfor %}
  </main>

  <!-- CLASSIC RÉSUMÉ VIEW -->
  <main id="classicView" class="view-container view-hidden" role="tabpanel" aria-labelledby="tab-classic" tabindex="-1">
    <div class="masthead-main">
      <h1 class="name" id="profileName">{{ resume.en.name }}</h1>
      <p class="role" id="profileRole">{{ resume.en.role }}</p>
      <p class="disciplines" id="profileDisciplines">{{ resume.en.disciplines }}</p>
      <div class="meta">
        <a href="mailto:{{ resume.en.email }}" id="metaEmail">{{ resume.en.email }}</a>
        <a href="{{ resume.en.links.linkedin.url }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="{{ resume.en.links.github.url }}" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="{{ resume.en.links.goldenfrijoles.url }}" target="_blank" rel="noopener noreferrer">{{ resume.en.links.goldenfrijoles.label }}</a>
        <span id="metaLocation">{{ resume.en.location }}</span>
      </div>
    </div>

    <section class="snapshot">
      <p class="eyebrow" id="snapshotTitle">{{ resume.en.ui.snapshotTitle }}</p>
      <div id="snapshotContent">
        {% for para in resume.en.snapshot %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
    </section>

    <section class="stats-section">
      <p class="eyebrow" id="statsTitle">{{ resume.en.ui.statsTitle }}</p>
      <div class="stats" id="statsContainer">
        {% for stat in resume.en.stats %}
        <div class="stat"><p class="figure">{{ stat.figure }}</p><p class="label">{{ stat.label }}</p></div>
        {% endfor %}
      </div>
    </section>

    <section class="experience">
      <p class="eyebrow" id="experienceTitle">{{ resume.en.ui.experienceTitle }}</p>
      <div id="featuredRoles">
        {% for role in resume.en.experience.featured %}
        <div class="role-card">
          <div class="role-head">
            <span class="role-company">{% if role.url %}<a href="{{ role.url }}" target="_blank" rel="noopener noreferrer">{{ role.company }}</a>{% else %}{{ role.company }}{% endif %}</span>
            <span class="role-dates">{{ role.dates }}</span>
          </div>
          <p class="role-title">{{ role.title }}</p>
          <ul class="role-bullets">
            {% for step in role.chain %}<li>{{ step }}</li>{% endfor %}
          </ul>
          {% if role.tags %}<p class="role-tags">{{ role.tags }}</p>{% endif %}
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="how">
      <p class="eyebrow" id="howTitle">{{ resume.en.ui.howIWorkTitle }}</p>
      <ul class="how-list" id="howList">
        {% for item in resume.en.howIWork %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </section>

    <section class="earlier-section">
      <p class="eyebrow" id="earlierTitle">{{ resume.en.ui.earlierTitle }}</p>
      <div id="earlierRoles">
        {% for role in resume.en.experience.earlier %}
        <div class="earlier-row">
          <div>
            <div class="co">{{ role.company }}</div>
            <div class="role">{{ role.title }}</div>
          </div>
          <div class="dates">{{ role.dates }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="education">
      <p class="eyebrow" id="educationTitle">{{ resume.en.ui.educationTitle }}</p>
      <div id="educationList">
        {% for e in resume.en.education %}
        <div class="edu-row">
          <div>
            <div class="credential">{{ e.credential }}</div>
            <div class="school">{{ e.school }}</div>
          </div>
          <div class="dates">{{ e.dates }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="philosophy">
      <p class="eyebrow" id="approachTitle">{{ resume.en.ui.approachTitle }}</p>
      <blockquote id="philosophyQuote">{{ resume.en.philosophy }}</blockquote>
    </section>

    <footer>
      <div class="footer-links">
        <a href="mailto:{{ resume.en.email }}" id="footerEmail">{{ resume.en.ui.emailLabel }}</a>
        <a href="{{ resume.en.links.linkedin.url }}" target="_blank" rel="noopener noreferrer" id="footerLinkedin">{{ resume.en.ui.linkedinLabel }}</a>
        <a href="{{ resume.en.links.github.url }}" target="_blank" rel="noopener noreferrer" id="footerGithub">{{ resume.en.ui.githubLabel }}</a>
        <a href="/resume.md" class="print-hide" id="footerMarkdown">{{ resume.en.ui.viewMarkdown }}</a>
        <a href="/print/" class="print-hide" id="footerPrint">{{ resume.en.ui.printable }}</a>
      </div>
      <p class="footer-note" id="footerNote">{{ resume.en.ui.lastUpdated }}</p>
    </footer>
  </main>

  <!-- TL;DR FULL-SCREEN VIEW -->
  <main id="tldrView" class="view-container tldr-view view-hidden" role="tabpanel" aria-labelledby="tab-tldr" tabindex="-1">
    <div class="tldr-content">
      <h1 class="tldr-greeting" id="tldrGreeting">{{ resume.en.tldr.greeting }}</h1>
      <p class="tldr-intro" id="tldrIntro">{{ resume.en.tldr.intro }}</p>
      <ul class="tldr-list" id="tldrBullets">
        {% for bullet in resume.en.tldr.bullets %}
        <li>{{ bullet | safe }}</li>
        {% endfor %}
      </ul>
      <p class="tldr-punchline" id="tldrPunchline">{{ resume.en.tldr.punchline }}</p>
      <p class="tldr-contact" id="tldrContact">
        <span id="tldrContactLabel">{{ resume.en.tldr.contactText }}</span>
        <a href="mailto:{{ resume.en.tldr.contactEmail }}" id="tldrContactEmail">{{ resume.en.tldr.contactEmail }}</a>
      </p>
    </div>
    <div class="tldr-footer-nav">
      <div class="footer-links">
        <a href="mailto:{{ resume.en.email }}" id="tldrFooterEmail">{{ resume.en.ui.emailLabel }}</a>
        <a href="{{ resume.en.links.linkedin.url }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="{{ resume.en.links.github.url }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </main>

</div>

<script>
  (function() {
    const RESUME_DATA = {{ resume | dump | safe }};
    let currentLang = 'en';
    let currentView = 'work';

    function esc(s) {
      return String(s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function detectInitialLang() {
      try {
        const stored = localStorage.getItem('resume_lang');
        if (stored === 'es' || stored === 'en') return stored;
        const navLang = (navigator.language || (navigator.languages && navigator.languages[0]) || '').toLowerCase();
        if (navLang.startsWith('es')) return 'es';
      } catch (e) {}
      return 'en';
    }

    function setLanguage(lang) {
      if (!RESUME_DATA[lang]) return;
      currentLang = lang;
      try {
        localStorage.setItem('resume_lang', lang);
      } catch (e) {}

      document.documentElement.lang = lang;
      const data = RESUME_DATA[lang];

      // Update Page Title and Meta Description
      document.title = data.ui.pageTitle;
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) metaDesc.setAttribute('content', data.ui.metaDesc);

      // Update Lang buttons
      const btnEn = document.getElementById('langBtnEn');
      const btnEs = document.getElementById('langBtnEs');
      if (btnEn && btnEs) {
        if (lang === 'en') {
          btnEn.classList.add('is-active');
          btnEn.setAttribute('aria-pressed', 'true');
          btnEs.classList.remove('is-active');
          btnEs.setAttribute('aria-pressed', 'false');
        } else {
          btnEs.classList.add('is-active');
          btnEs.setAttribute('aria-pressed', 'true');
          btnEn.classList.remove('is-active');
          btnEn.setAttribute('aria-pressed', 'false');
        }
      }

      // Update Eyebrow and Buttons
      document.getElementById('tab-work').textContent = data.ui.workButton;
      document.getElementById('tab-classic').textContent = data.ui.classicButton;
      document.getElementById('tab-tldr').textContent = data.ui.tldrButton;
      document.getElementById('viewSwitch').setAttribute('aria-label', data.ui.viewsLabel);
      const cv = document.getElementById('cvLink');
      cv.setAttribute('href', data.ui.cvFile);
      document.getElementById('cvLong').textContent = data.ui.cvButton;
      cv.setAttribute('aria-label', data.ui.cvButton + ' (PDF)');
      const footerPrint = document.getElementById('footerPrint');
      if (footerPrint) {
        footerPrint.textContent = data.ui.printable;
        footerPrint.setAttribute('href', '/print/?lang=' + lang);
      }

      // Work view: both languages are server-rendered; show the right one.
      document.querySelectorAll('[data-lang-block]').forEach(function(el) {
        el.hidden = el.getAttribute('data-lang-block') !== lang;
      });

      // Update Masthead
      document.getElementById('profileRole').textContent = data.role;
      document.getElementById('profileDisciplines').textContent = data.disciplines;
      document.getElementById('metaLocation').textContent = data.location;

      // Update Profile
      document.getElementById('snapshotTitle').textContent = data.ui.snapshotTitle;
      const snapshotEl = document.getElementById('snapshotContent');
      if (snapshotEl) {
        snapshotEl.innerHTML = data.snapshot.map(p => `<p>${esc(p)}</p>`).join('');
      }

      // Update Stats
      document.getElementById('statsTitle').textContent = data.ui.statsTitle;
      const statsContainer = document.getElementById('statsContainer');
      if (statsContainer) {
        statsContainer.innerHTML = data.stats.map(s => `<div class="stat"><p class="figure">${esc(s.figure)}</p><p class="label">${esc(s.label)}</p></div>`).join('');
      }

      // Update Featured Experience
      document.getElementById('experienceTitle').textContent = data.ui.experienceTitle;
      const featEl = document.getElementById('featuredRoles');
      if (featEl) {
        featEl.innerHTML = data.experience.featured.map(role => `
          <div class="role-card">
            <div class="role-head">
              <span class="role-company">${role.url ? `<a href="${esc(role.url)}" target="_blank" rel="noopener noreferrer">${esc(role.company)}</a>` : esc(role.company)}</span>
              <span class="role-dates">${esc(role.dates)}</span>
            </div>
            <p class="role-title">${esc(role.title)}</p>
            <ul class="role-bullets">${role.chain.map(step => `<li>${esc(step)}</li>`).join('')}</ul>
            ${role.tags ? `<p class="role-tags">${esc(role.tags)}</p>` : ''}
          </div>
        `).join('');
      }

      // Update How I Work
      document.getElementById('howTitle').textContent = data.ui.howIWorkTitle;
      const howEl = document.getElementById('howList');
      if (howEl) {
        howEl.innerHTML = data.howIWork.map(i => `<li>${esc(i)}</li>`).join('');
      }

      // Update Earlier Roles
      document.getElementById('earlierTitle').textContent = data.ui.earlierTitle;
      const earlierEl = document.getElementById('earlierRoles');
      if (earlierEl) {
        earlierEl.innerHTML = data.experience.earlier.map(role => `
          <div class="earlier-row">
            <div>
              <div class="co">${esc(role.company)}</div>
              <div class="role">${esc(role.title)}</div>
            </div>
            <div class="dates">${esc(role.dates)}</div>
          </div>
        `).join('');
      }

      // Update Education
      document.getElementById('educationTitle').textContent = data.ui.educationTitle;
      const eduEl = document.getElementById('educationList');
      if (eduEl) {
        eduEl.innerHTML = data.education.map(e => `
          <div class="edu-row">
            <div>
              <div class="credential">${esc(e.credential)}</div>
              <div class="school">${esc(e.school)}</div>
            </div>
            <div class="dates">${esc(e.dates)}</div>
          </div>
        `).join('');
      }

      // Update Philosophy
      document.getElementById('approachTitle').textContent = data.ui.approachTitle;
      document.getElementById('philosophyQuote').textContent = data.philosophy;

      // Update Footer
      document.getElementById('footerEmail').textContent = data.ui.emailLabel;
      document.getElementById('footerLinkedin').textContent = data.ui.linkedinLabel;
      document.getElementById('footerGithub').textContent = data.ui.githubLabel;
      const footerMarkdown = document.getElementById('footerMarkdown');
      if (footerMarkdown) {
        footerMarkdown.textContent = data.ui.viewMarkdown;
        footerMarkdown.setAttribute('href', data.ui.markdownUrl);
      }
      document.getElementById('footerNote').textContent = data.ui.lastUpdated;

      // Update TL;DR View
      document.getElementById('tldrGreeting').textContent = data.tldr.greeting;
      document.getElementById('tldrIntro').textContent = data.tldr.intro;
      const tldrBullets = document.getElementById('tldrBullets');
      if (tldrBullets) {
        // tldr bullets deliberately carry inline anchor markup from the data file
        tldrBullets.innerHTML = data.tldr.bullets.map(b => `<li>${b}</li>`).join('');
      }
      document.getElementById('tldrPunchline').textContent = data.tldr.punchline;
      document.getElementById('tldrContactLabel').textContent = data.tldr.contactText;
      document.getElementById('tldrFooterEmail').textContent = data.ui.emailLabel;
      setTitleForView();
    }

    const VIEWS = ['work', 'classic', 'tldr'];
    const PANEL = { work: 'workView', classic: 'classicView', tldr: 'tldrView' };

    function viewFromHash() {
      const h = (window.location.hash || '').replace('#', '');
      if (h === 'classic' || h === 'tldr' || h === 'work') return h;
      if (h === 'forward') return 'work';
      return 'work';
    }

    function setTitleForView() {
      const data = RESUME_DATA[currentLang];
      const names = { work: data.ui.workButton, classic: data.ui.classicButton, tldr: data.ui.tldrButton };
      document.title = currentView === 'work' ? data.ui.pageTitle : names[currentView] + ' — ' + data.name;
    }

    function setView(view, opts) {
      opts = opts || {};
      if (VIEWS.indexOf(view) === -1) view = 'work';
      currentView = view;
      VIEWS.forEach(function(v) {
        const tab = document.getElementById('tab-' + v);
        const panel = document.getElementById(PANEL[v]);
        const on = v === view;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        panel.classList.toggle('view-hidden', !on);
      });
      setTitleForView();
      if (opts.push) {
        const url = window.location.pathname + window.location.search + '#' + view;
        if (history.pushState) history.pushState({ view: view }, '', url);
      }
      if (opts.scroll && window.scrollY > 120) window.scrollTo({ top: 0 });
    }

    // Tabs: click, plus arrow/Home/End keys per the WAI-ARIA tabs pattern.
    const tabs = Array.prototype.slice.call(document.querySelectorAll('.view-tab'));
    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() {
        setView(tab.getAttribute('data-view'), { push: true, scroll: true });
      });
      tab.addEventListener('keydown', function(e) {
        let next = null;
        if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (e.key === 'Home') next = tabs[0];
        else if (e.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          e.preventDefault();
          next.focus();
          setView(next.getAttribute('data-view'), { push: true });
        }
      });
    });

    // In-content links that jump to another view ("See the full résumé").
    document.querySelectorAll('[data-goto-view]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        setView(a.getAttribute('data-goto-view'), { push: true });
        window.scrollTo({ top: 0 });
        document.getElementById('tab-' + a.getAttribute('data-goto-view')).focus();
      });
    });

    window.addEventListener('popstate', function() { setView(viewFromHash()); });
    window.addEventListener('hashchange', function() { setView(viewFromHash()); });

    // Copy-to-clipboard for the email address.
    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
      return new Promise(function(resolve, reject) {
        const ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy') ? resolve() : reject(); } catch (err) { reject(err); }
        document.body.removeChild(ta);
      });
    }
    document.querySelectorAll('.copy-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const label = btn.querySelector('.copy-text');
        const status = btn.parentNode.querySelector('.copy-status');
        copyText(btn.getAttribute('data-copy')).then(function() {
          btn.classList.add('is-copied');
          label.textContent = btn.getAttribute('data-label-copied');
          if (status) status.textContent = btn.getAttribute('data-label-copied');
          clearTimeout(btn._t);
          btn._t = setTimeout(function() {
            btn.classList.remove('is-copied');
            label.textContent = btn.getAttribute('data-label-copy');
            if (status) status.textContent = '';
          }, 2000);
        }).catch(function() {});
      });
    });

    document.getElementById('langBtnEn').addEventListener('click', function() { setLanguage('en'); });
    document.getElementById('langBtnEs').addEventListener('click', function() { setLanguage('es'); });

    // Initialize
    currentView = viewFromHash();
    setLanguage(detectInitialLang());
    setView(currentView);
  })();
</script>
</body>
</html>
