---
pagination:
  data: languages
  size: 1
  alias: item
languages:
  - lang: en
    permalink: resume.md
  - lang: es
    permalink: resume-es.md
permalink: "{{ item.permalink }}"
eleventyExcludeFromCollections: true
---
{% set data = resume[item.lang] %}
# {{ data.name | safe }}
**{{ data.role | safe }}** — {{ data.location | safe }}
{{ data.links.website.url }} · {{ data.email }} · {{ data.links.linkedin.url }}

## {{ data.ui.snapshotTitle | safe }}
{% for para in data.snapshot %}
{{ para | safe }}
{% endfor %}
## {{ data.ui.experienceTitle | safe }}
{% for role in data.experience.featured %}
### {{ role.company | safe }} — {{ role.dates | safe }}
*{{ role.title | safe }}*
{% for step in role.chain %}- {{ step | safe }}
{% endfor %}{% if role.tags %}{{ role.tags | safe }}
{% endif %}
{% endfor %}
## {{ data.ui.earlierTitle | safe }}
{% for role in data.experience.earlier %}- **{{ role.company | safe }}** — {{ role.title | safe }} ({{ role.dates | safe }})
{% endfor %}
## {{ data.ui.capabilitiesTitle | safe }}
{{ data.skills | join(", ") | safe }}

## {{ data.ui.timelineTitle | safe }}
{% for entry in data.timeline %}- {{ entry.year | safe }} — {{ entry.role | safe }} ({{ entry.sub | safe }})
{% endfor %}
## {{ data.ui.approachTitle | safe }}
{{ data.philosophy | safe }}

