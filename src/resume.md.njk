---
pagination:
  data: languages
  size: 1
  alias: item
languages:
  - lang: en
    permalink: resume.md
  - lang: es
    permalink: resume-es.md
permalink: "{{ item.permalink }}"
eleventyExcludeFromCollections: true
---
{% set data = resume[item.lang] %}
{%- macro roleBlock(role) %}
### {{ role.company | safe }} — {{ role.dates | safe }}
{{ role.title | safe }}{% if role.url %} · {{ role.url }}{% endif %}
{% for step in role.chain %}
- {{ step | safe }}
{%- endfor %}
{% if role.tags %}
{{ role.tags | safe }}
{% endif %}
{%- endmacro %}
# {{ data.name | safe }}
**{{ data.role | safe }}**

{{ data.disciplines | safe }}

- Location: {{ data.location | safe }}
- Email: {{ data.email }}
- LinkedIn: {{ data.links.linkedin.url }}
- GitHub: {{ data.links.github.url }}
- Site: {{ data.links.site.url }}
- CV (PDF): {{ data.links.site.url }}{{ data.ui.cvFile }}

## {{ data.ui.snapshotTitle | safe }}
{% for para in data.snapshot %}
{{ para | safe }}
{% endfor %}
## {{ data.ui.statsTitle | safe }}
{% for stat in data.stats %}- **{{ stat.figure | safe }}** — {{ stat.label | safe }}
{% endfor %}
## {{ data.ui.experienceTitle | safe }}
{% for role in data.experience.featured %}{{ roleBlock(role) }}
{% endfor %}
## {{ data.ui.earlierTitle | safe }}
{% for role in data.experience.earlier %}- **{{ role.company | safe }}** — {{ role.title | safe }} ({{ role.dates | safe }})
{% endfor %}
## {{ data.ui.venturesTitle | safe }}
{% for role in data.experience.ventures %}{{ roleBlock(role) }}
{% endfor %}
## {{ data.ui.educationTitle | safe }}
{% for e in data.education %}- **{{ e.credential | safe }}** — {{ e.school | safe }}{% if e.dates %} ({{ e.dates | safe }}){% endif %}
{% endfor %}
## {{ data.work.contactTitle | safe }}
{{ data.work.contactBody | safe }}

- Email: {{ data.email }}
- LinkedIn: {{ data.links.linkedin.url }}
- GitHub: {{ data.links.github.url }}

---
{{ data.ui.lastUpdated | safe }}
