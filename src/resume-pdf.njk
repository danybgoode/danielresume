---
# One sheet per CV variant: "classic" is the executive CV at /print/, the
# lanes (resume[lang].lanes) render at /print/<lane>/.
pagination:
  data: variants
  size: 1
  alias: variant
variants: ["classic", "a", "p"]
permalink: "{% if variant == 'classic' %}print/index.html{% else %}print/{{ variant }}/index.html{% endif %}"
eleventyExcludeFromCollections: true
---
{% set lanePdf = variant != "classic" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ resume.en.lanes[variant].pdfTitle if lanePdf else resume.en.ui.pdfTitle }}</title>
<meta name="author" content="{{ resume.en.name }}">
<meta name="description" content="{{ resume.en.ui.metaDesc }}">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/png" href="/cauldron.png">

<style>
  /* Static (non-variable) instances on purpose: Chrome embeds variable fonts
     in PDFs as Type 3 glyph programs; static TrueType embeds cleanly, which is
     friendlier to ATS parsers and PDF viewers. */
  @font-face{ font-family:"Paper Mono"; font-weight:400; src:url(/fonts/static/PaperMono-Regular.woff2) format("woff2"); }
  @font-face{ font-family:"Paper Mono"; font-weight:500; src:url(/fonts/static/PaperMono-Medium.woff2) format("woff2"); }
  @font-face{ font-family:"Paper Mono"; font-weight:600; src:url(/fonts/static/PaperMono-SemiBold.woff2) format("woff2"); }
  @font-face{ font-family:"Paper Mono"; font-weight:700; src:url(/fonts/static/PaperMono-Bold.woff2) format("woff2"); }
</style>

<style>
  /* ============================================================
     PRINT SHEET — structured for machines first, humans second.

     THE LOAD-BEARING RULE: a PDF printed from HTML has no notion of
     "columns". Chrome emits text in visual line order across the FULL
     page width, so any two independent text blocks that share a
     horizontal band get interleaved in the extracted text — which is
     what an ATS parser, an LLM, and a human dragging a selection all
     read. The previous version of this sheet used `column-count:2` for
     experience, `column-count:3` for earlier career, and a flex sidebar
     beside the main column; its extracted text merged the profile
     paragraphs, the stats, and two unrelated roles line by line.

     So: ONE column, top to bottom, DOM order == reading order.
     The only elements allowed to share a band are a company and its
     own dates (they belong together and concatenate correctly).
     Do not reintroduce column-count, float, or a side rail here.
     ============================================================ */

  :root{
    --bg:#FAFAF8;
    --text:#1E1E1E;
    --muted:#5F5F5F;
    --faint:#8C8983;
    --border:#E4E1DB;
    --serif:"Paper Mono", ui-monospace, Menlo, Consolas, monospace;
    --sans:"Paper Mono", ui-monospace, Menlo, Consolas, monospace;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    font-synthesis:none;
    background:#EDEBE6;
    font-family:var(--serif);
    color:var(--text);
    padding:48px 16px;
  }

  /* ---------- On-screen-only control bar ---------- */
  .no-print{
    max-width:210mm;
    margin:0 auto 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    font-family:var(--sans);
  }
  .no-print a, .no-print button{
    font-family:var(--sans);
    font-size:12px;
    color:var(--muted);
    background:none;
    border:none;
    cursor:pointer;
    text-decoration:none;
  }
  .no-print .actions{ display:flex; align-items:center; gap:14px; }
  .no-print .lang-btn{ font-weight:600; color:var(--faint); }
  .no-print .lang-btn.is-active{ color:var(--text); text-decoration:underline; }
  .no-print .print-btn{
    font-weight:600;
    color:#fff;
    background:#111;
    padding:7px 14px;
    border-radius:3px;
  }

  /* ---------- The sheet ---------- */
  .sheet{
    width:210mm;
    margin:0 auto;
    background:var(--bg);
    padding:13mm 16mm;
    box-shadow:0 12px 40px rgba(0,0,0,.18);
  }

  /* ---------- Typography primitives ---------- */
  h1,h2,h3{ margin:0; font-weight:500; }
  p{ margin:0; }
  a{ color:var(--text); text-decoration:none; }

  .section-title{
    font-family:var(--sans);
    font-size:7.8pt;
    font-weight:700;
    /* Deliberately modest tracking: wide letter-spacing makes Chrome emit
       each glyph as its own positioned run, and pdftotext then reads
       "E X P E R I E N C E". Section headings are the anchors an ATS
       looks for, so they have to survive extraction intact. */
    letter-spacing:.055em;
    text-transform:uppercase;
    color:var(--muted);
    margin:0 0 5.5pt;
    padding-bottom:3pt;
    border-bottom:1px solid var(--border);
  }
  .rule{ border:none; border-top:1px solid var(--border); margin:0; }

  /* ---------- Header ---------- */
  .head{ padding-bottom:4pt; }
  .head h1{
    font-family:var(--serif);
    font-size:24.8pt;
    letter-spacing:-.01em;
    line-height:1.05;
    margin:0 0 4pt;
  }
  .head .role-line{
    font-family:var(--sans);
    font-size:9.7pt;
    font-weight:600;
    color:var(--text);
    margin:0 0 3pt;
  }
  .head .disciplines{
    font-family:var(--serif);
    font-size:9.1pt;
    line-height:1.42;
    color:var(--muted);
    margin:0 0 7pt;
  }
  /* One flowing contact line — extracts as a single readable run, and
     every item is a real <a href>, so the PDF carries link annotations. */
  .head .contact{
    font-family:var(--sans);
    font-size:8.8pt;
    line-height:1.6;
    color:var(--text);
    margin:0;
  }
  .head .contact a{ text-decoration:none; border-bottom:.5px solid var(--border); }
  .head .contact .sep{ color:var(--faint); padding:0 2pt; }
  /* Keep the city pair from breaking mid-phrase across the wrap. */
  .head .contact .loc{ white-space:nowrap; }

  /* ---------- Section spacing ---------- */
  section{ padding-top:13pt; }

  /* ---------- Summary ---------- */
  .summary-text{
    font-family:var(--serif);
    font-size:9.6pt;
    line-height:1.5;
    margin:0 0 5pt;
  }
  [hidden]{ display:none !important; }
  /* ---------- Profile ---------- */
  .profile p{
    font-family:var(--serif);
    font-size:9.5pt;
    line-height:1.48;
    margin:0 0 5pt;
  }
  .profile p:last-child{ margin-bottom:0; }

  /* ---------- At a glance: a single flowing line, never a grid.
     A grid of figures over labels extracts as "15+ $70M+ 70+" then
     "YEARS IN… BUDGET…" — six numbers divorced from six meanings.
     Inline, each fact is a complete phrase wherever it is cut. ---------- */
  .glance{
    font-family:var(--sans);
    font-size:8.8pt;
    line-height:1.6;
    color:var(--text);
    margin:0;
  }
  .glance .figure{ font-family:var(--serif); font-weight:600; }
  .glance .sep{ color:var(--faint); padding:0 5pt; }

  /* ---------- Experience ---------- */
  .role{
    break-inside:avoid;
    page-break-inside:avoid;
    padding:8pt 0;
    border-top:1px solid var(--border);
  }
  .role:first-of-type{ border-top:none; padding-top:2pt; }
  /* Flex, not float: DOM order is company-then-dates, so the extracted
     line reads "AB InBev 2020 — 2023" rather than the reverse. */
  .role-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:8pt;
    margin-bottom:1pt;
  }
  .role-head h3{
    font-family:var(--sans);
    font-weight:700;
    font-size:9.9pt;
    line-height:1.25;
  }
  .role-head h3 a{ border-bottom:.5px solid var(--border); }
  .role-dates{
    font-family:var(--sans);
    font-size:8.1pt;
    color:var(--muted);
    white-space:nowrap;
    font-variant-numeric:tabular-nums;
  }
  .role-title{
    font-family:var(--sans);
    font-size:8.6pt;
    font-style:normal;
    color:var(--muted);
    margin:0 0 4pt;
  }
  .role-bullets{
    margin:0 0 4pt;
    padding-left:11pt;
    font-family:var(--serif);
    font-size:9.1pt;
    line-height:1.55;
  }
  .role-bullets li{ margin-bottom:2.5pt; }
  .role-bullets li:last-child{ margin-bottom:0; }
  .role-bullets li::marker{ color:var(--faint); }
  .role-tags{
    font-family:var(--sans);
    font-size:7.8pt;
    font-style:normal;
    color:var(--faint);
    line-height:1.4;
    margin:0;
  }

  /* ---------- How I work ---------- */
  .how-list{
    margin:0;
    padding-left:11pt;
    font-family:var(--serif);
    font-size:9.1pt;
    line-height:1.55;
  }
  .how-list li{ margin-bottom:2.5pt; break-inside:avoid; }
  .how-list li:last-child{ margin-bottom:0; }
  .how-list li::marker{ color:var(--faint); }

  /* ---------- Earlier career: one line per role, full width.
     (Was a 3-column grid; three unrelated employers per band.) ---------- */
  .earlier-list{ margin:0; padding:0; list-style:none; }
  .earlier-list li{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:8pt;
    font-family:var(--sans);
    font-size:8.6pt;
    line-height:1.5;
    padding:1pt 0;
    break-inside:avoid;
  }
  .earlier-list .co{ font-weight:600; }
  .earlier-list .title{ color:var(--muted); font-weight:400; }
  .earlier-list .dates{
    color:var(--faint);
    font-size:8.1pt;
    white-space:nowrap;
    font-variant-numeric:tabular-nums;
  }

  /* ---------- Education ---------- */
  .edu-list{ margin:0; padding:0; list-style:none; }
  .edu-list li{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:8pt;
    font-family:var(--sans);
    font-size:8.8pt;
    line-height:1.5;
  }
  .edu-list .credential{ font-weight:600; }
  .edu-list .school{ color:var(--muted); font-weight:400; }
  .edu-list .dates{ color:var(--faint); font-size:8.1pt; white-space:nowrap; }
  .edu-list li.edu-note{
    display:block;
    font-family:var(--serif);
    font-size:8.3pt;
    line-height:1.45;
    color:var(--muted);
    margin-top:2pt;
  }

  /* Lane CVs carry a summary, a current role and skills on the same one page. */
  .sheet--lane section{ padding-top:8pt; }
  .sheet--lane .role{ padding:6pt 0; }

  /* ---------- Skills (lane CVs) ---------- */
  .skills-list{
    margin:0;
    padding:0;
    list-style:none;
    font-family:var(--serif);
    font-size:8.8pt;
    line-height:1.5;
  }
  .skills-list li{ margin-bottom:1pt; }
  .skills-list .label{ font-weight:600; }

  /* ---------- Footer ---------- */
  .foot-note{
    padding-top:8pt;
    margin-top:8pt;
    border-top:1px solid var(--border);
    text-align:center;
  }
  .foot-note p{
    font-family:var(--sans);
    font-size:7.6pt;
    color:var(--faint);
    margin:0;
  }
  .foot-note a{ color:var(--faint); border-bottom:.5px solid var(--border); }

  /* ---------- Print ---------- */
  @page{
    size:A4;
    /* Page margins live on @page, not on .sheet padding — padding only
       applies to the first and last fragment, so a two-page sheet would
       run its second page hard against the paper edge. */
    margin:15mm 17mm;
  }
  {% if lanePdf %}
  /* Lane CVs run fuller than the classic sheet, so they get slimmer margins
     to stay on one page in browsers that set text a little looser. */
  @page{ margin:11mm 14mm; }
  @media print{ .sheet--lane{ zoom:.75; } }
  {% endif %}
  @media print{
    body{ background:#fff; padding:0; }
    .no-print{ display:none !important; }
    .sheet{
      width:auto;
      margin:0;
      padding:0;
      box-shadow:none;
      background:#fff;
      /* The sheet's type scale is set for this zoom. Until the contact line
         could wrap it overflowed the page and Chrome shrank everything to fit,
         while Safari printed at full size onto two pages; an explicit zoom makes
         every browser print the same one-page layout. */
      zoom:.78;
    }
  }
</style>
</head>
<body>
<div class="no-print">
  <a href="/#classic" id="backLink">{{ resume.en.ui.pdfBackLink }}</a>
  <div class="actions">
    <button type="button" class="lang-btn is-active" id="langBtnEn" data-lang="en">EN</button>
    <button type="button" class="lang-btn" id="langBtnEs" data-lang="es">ES</button>
    <button type="button" class="print-btn" id="printBtn">{{ resume.en.ui.pdfPrintButton }}</button>
  </div>
</div>
{#
  Executive one-page CV. Both languages are rendered here and the toggle only
  shows one, so the PDF build and a JS-less print produce identical text.
  ONE column, DOM order == reading order (see the note at the top of <style>).
#}
{% for lang in ["en", "es"] %}
{% set d = resume[lang] %}
{% set c = d.lanes[variant] if lanePdf else d.cv %}
<article class="sheet{% if lanePdf %} sheet--lane{% endif %}" data-lang-block="{{ lang }}" lang="{{ lang }}"{% if lang != "en" %} hidden{% endif %}>
  <header class="head">
    <h1>{{ d.name }}</h1>
    <p class="role-line">{{ c.role }}</p>
    <p class="disciplines">{{ c.tagline }}</p>
    <p class="contact"><a href="mailto:{{ d.email }}">{{ d.email }}</a> <span class="sep">·</span> <a href="{{ d.links.linkedin.url }}">{{ d.links.linkedin.label }}</a> <span class="sep">·</span> <a href="{{ d.links.github.url }}">{{ d.links.github.label }}</a> <span class="sep">·</span> <a href="{{ d.links.site.url }}">{{ d.links.site.label }}</a> <span class="sep">·</span> <span class="loc">{{ d.location }}</span></p>
  </header>
  <hr class="rule">
  {% if lanePdf %}
  <section class="summary">
    <h2 class="section-title">{{ d.lanesShared.titles.summary }}</h2>
    <p class="summary-text">{{ c.summary }}</p>
  </section>
  <section class="current">
    <h2 class="section-title">{{ d.lanesShared.titles.current }}</h2>
    <div class="role">
      <div class="role-head"><h3>{{ c.current.company }}</h3><span class="role-dates">{{ c.current.dates }}</span></div>
      <p class="role-title">{{ c.current.title }}</p>
      <ul class="role-bullets">{% for b in c.current.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    </div>
  </section>
  {% endif %}
  <section class="experience">
    <h2 class="section-title">{{ d.ui.experienceTitle }}</h2>
    {% for role in c.experience %}
    <div class="role">
      <div class="role-head"><h3>{{ role.company }}</h3><span class="role-dates">{{ role.dates }}</span></div>
      <p class="role-title">{{ role.title }}</p>
      {% if role.bullets.length %}<ul class="role-bullets">{% for b in role.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  <section class="earlier">
    <h2 class="section-title">{{ d.ui.earlierTitle }}</h2>
    <ul class="earlier-list">{% for r in d.experience.earlier %}{% if not lanePdf or not (r.company in c.hideEarlier) %}<li><span><span class="co">{{ r.company }}</span> — <span class="title">{{ r.title }}</span></span><span class="dates">{{ r.dates }}</span></li>{% endif %}{% endfor %}</ul>
  </section>
  {% if lanePdf %}
  <section class="ventures">
    <h2 class="section-title">{{ d.lanesShared.titles.ventures }}</h2>
    <ul class="earlier-list">{% for r in d.lanesShared.ventures %}<li><span><span class="co">{{ r.company }}</span> — <span class="title">{{ r.title }}</span></span><span class="dates">{{ r.dates }}</span></li>{% endfor %}</ul>
  </section>
  <section class="skills">
    <h2 class="section-title">{{ d.lanesShared.titles.skills }}</h2>
    <ul class="skills-list">{% for s in c.skills %}<li><span class="label">{{ s.label }}:</span> {{ s.text }}</li>{% endfor %}<li><span class="label">{{ d.lanesShared.titles.languages }}:</span> {{ d.lanesShared.languages }}</li></ul>
  </section>
  {% else %}
  <section class="ventures">
    <h2 class="section-title">{{ d.ui.venturesTitle }}</h2>
    {% for role in d.cv.ventures %}
    <div class="role">
      <div class="role-head"><h3>{{ role.company }}</h3><span class="role-dates">{{ role.dates }}</span></div>
      <p class="role-title">{{ role.title }}</p>
      {% if role.bullets.length %}<ul class="role-bullets">{% for b in role.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}
  <section class="education">
    <h2 class="section-title">{{ d.ui.educationTitle }}</h2>
    {# Lane CVs carry the dissertation directly under the MSc, the first credential. #}
    <ul class="edu-list">{% for e in d.education %}<li><span><span class="credential">{{ e.credential }}</span> — <span class="school">{{ e.school }}</span></span><span class="dates">{{ e.dates }}</span></li>{% if lanePdf and loop.first %}<li class="edu-note">{{ d.lanesShared.dissertation }}</li>{% endif %}{% endfor %}</ul>
  </section>
</article>
{% endfor %}

<script>
  (function() {
    {% if lanePdf %}
    const TITLES = { en: {{ resume.en.lanes[variant].pdfTitle | dump | safe }}, es: {{ resume.es.lanes[variant].pdfTitle | dump | safe }} };
    {% else %}
    const TITLES = { en: {{ resume.en.ui.pdfTitle | dump | safe }}, es: {{ resume.es.ui.pdfTitle | dump | safe }} };
    {% endif %}
    const UI = {
      en: { back: {{ resume.en.ui.pdfBackLink | dump | safe }}, print: {{ resume.en.ui.pdfPrintButton | dump | safe }} },
      es: { back: {{ resume.es.ui.pdfBackLink | dump | safe }}, print: {{ resume.es.ui.pdfPrintButton | dump | safe }} }
    };
    function render(lang) {
      if (!TITLES[lang]) return;
      document.documentElement.lang = lang;
      // <title> becomes the PDF's /Title metadata, read first by many ATS parsers.
      document.title = TITLES[lang];
      document.querySelectorAll('[data-lang-block]').forEach(function(el) {
        el.hidden = el.getAttribute('data-lang-block') !== lang;
      });
      document.getElementById('langBtnEn').classList.toggle('is-active', lang === 'en');
      document.getElementById('langBtnEs').classList.toggle('is-active', lang === 'es');
      document.getElementById('printBtn').textContent = UI[lang].print;
      document.getElementById('backLink').textContent = UI[lang].back;
    }
    function detectLang() {
      try {
        const q = new URLSearchParams(window.location.search).get('lang');
        if (q === 'es' || q === 'en') return q;
        const stored = localStorage.getItem('resume_lang');
        if (stored === 'es' || stored === 'en') return stored;
      } catch (e) {}
      return 'en';
    }
    render(detectLang());
    document.getElementById('langBtnEn').addEventListener('click', function() { render('en'); });
    document.getElementById('langBtnEs').addEventListener('click', function() { render('es'); });
    document.getElementById('printBtn').addEventListener('click', function() { window.print(); });
  })();
</script>
</body>
</html>
