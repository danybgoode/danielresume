<div id="toast" role="status"></div>

<script>
{% raw %}
const $=s=>document.querySelector(s),T=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(T.i);T.i=setTimeout(()=>t.classList.remove('on'),2600)};
const calm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};

// pixel sprites
const SP={cauldron:{c:{k:'#1b1b2f',a:'#3dff7a',b:'#c8ffd8',g:'#4a4a70',h:'#8888b8',f:'#ff9a1f',y:'#ffe14d'},r:["...b....a..b..","..a...b....a..",".kkkkkkkkkkkk.","kaabaaabaaabak","kggggggggggggk","kghhgggggggggk","kghggggggggggk",".kggggggggggk.","..kkggggggkk..","..f.f.yf.f.f.."]},
invader:{c:{i:'#3dff7a'},r:["..i.....i..","...i...i...","..iiiiiii..",".ii.iii.ii.","iiiiiiiiiii","i.iiiiiii.i","i.i.....i.i","...ii.ii..."]},
flame:{c:{o:'#ff6a00',y:'#ffd23d',r:'#d8230f'},r:["...o...","..oo...","..ooo.o",".oooyoo",".ooyyoo","ooyyyyo","ooyyyyo",".ooyyo."]},
cloud:{c:{w:'#e8e8f8',s:'#9a9ac8'},r:["....wwww....","..wwwwwwww..",".wwwwwwwwwww","wwwwwwwwwwww","ssssssssssss"]},
heart:{c:{r:'#ff3b5c'},r:[".rr.rr.","rrrrrrr","rrrrrrr",".rrrrr.","..rrr..","...r..."]}};
document.querySelectorAll('.sp').forEach(e=>{const s=SP[e.dataset.s],z=+e.dataset.z,w=Math.max(...s.r.map(r=>r.length));let h='';s.r.forEach((r,y)=>[...r].forEach((ch,x)=>{if(s.c[ch])h+=`<rect x="${x}" y="${y}" width="1" height="1" fill="${s.c[ch]}"/>`}));e.innerHTML=`<svg width="${w*z}" height="${s.r.length*z}" viewBox="0 0 ${w} ${s.r.length}" aria-hidden="true">${h}</svg>`});

// themes (the number is the joke: there are six, not 99). The choice sticks for the next visit.
const TH=[[61,'SPACE INVADERS',{}],[17,'DISCO INFERNO',{bg:'#1a0524',dot:'#5a0c44',pan:'#2a0a3c',ln:'#ff5ccf',h1:'#4a0a6e',h2:'#0a6e8e',tx:'#ffd0f5',hi:'#5ef2ff',ac:'#ffe14d',hh:'#fff'}],[1,'SKY BLUE DREAMS',{bg:'#cfe8ff',dot:'#b2d6f7',pan:'#f4faff',ln:'#2a5db0',h1:'#2f6fd0',h2:'#6aa6ee',tx:'#1d2f5c',hi:'#a80d44',ac:'#0a6e32',hh:'#fff'}],[70,'MUSTARD GROOVE',{bg:'#3b1f0e',dot:'#5e3514',pan:'#4a2812',ln:'#f2a900',h1:'#7a3b0c',h2:'#b3261e',tx:'#f6d9a8',hi:'#ffc933',ac:'#9be564',hh:'#ffe9a8'}],[42,'GRAPE SODA',{bg:'#120a3a',dot:'#2a1a78',pan:'#1c1260',ln:'#b69cff',h1:'#3a1d9a',h2:'#8a2be2',tx:'#dcd0ff',hi:'#7dffd4',ac:'#ff9ee6',hh:'#fff'}],[8,'FRIJOL GOLD',{bg:'#1a1208',dot:'#3d2b0c',pan:'#261a0a',ln:'#e8c15a',h1:'#4a3210',h2:'#7a2e12',tx:'#e9d7b0',hi:'#ffd35a',ac:'#b7e07a',hh:'#ffe9a0'}]];
const VARS=['bg','dot','pan','ln','h1','h2','tx','hi','ac','hh'];let ti=0;
function theme(i){ti=i;const [n,nm,v]=TH[i],r=document.documentElement.style;VARS.forEach(k=>v[k]?r.setProperty('--'+k,v[k]):r.removeProperty('--'+k));
 document.querySelector('meta[name=theme-color]').content=v.bg||'#150a26';
 $('#thm').innerHTML=`NOW VIEWING THEME <b>${n}</b> OF <b>99</b>: ${nm}`;
 $('#tk').textContent=` ★ NOW ENTERING: ${nm} ★ WELCOME TO MY HOME PAGE ★ SIGN MY GUESTBOOK (JUST E-MAIL ME) ★ THIS PAGE IS 100% Y2K COMPLIANT ★`.repeat(3);store.set('funk-theme',i)}
$('#shuf').onclick=()=>{let n;do n=Math.floor(Math.random()*TH.length);while(n===ti);theme(n)};
theme(Math.min(TH.length-1,Math.max(0,+store.get('funk-theme')||0)));

// dial-up gate = the "turn the funk on" moment. The page behind it is inert until connected.
const dial=$('#dial'),page=$('#page'),st=$('#st'),go=$('#go');let busy=0,timers=[];
const later=(f,ms)=>timers.push(setTimeout(f,ms));
function enter(){timers.forEach(clearTimeout);timers=[];dial.hidden=true;page.inert=false;busy=0;try{sessionStorage.setItem('funk-connected','1')}catch(e){}type()}
function connect(){if(busy)return;busy=1;go.disabled=true;
 if(calm){st.textContent='Connected at 56000 bps.';later(enter,400);return}
 $('#pg').style.width='100%';
 [['Dialing…',0],['Verifying user name and password…',900],['Logging on to the funk…',1800],['Connected at 56000 bps.',2500]].forEach(([m,t])=>later(()=>st.textContent=m,t));
 later(()=>{dial.classList.add('out');later(()=>{dial.classList.remove('out');enter()},450)},3000)}
function showDial(){document.documentElement.classList.remove('connected');dial.hidden=false;page.inert=true;go.disabled=false;busy=0;const p=$('#pg');p.style.transition='none';p.style.width='0';void p.offsetWidth;p.style.transition='';st.textContent='Ready to dial.';scrollTo(0,0);go.focus()}
go.onclick=connect;
dial.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();enter()}
 if(e.key==='Tab'){const f=[...dial.querySelectorAll('a[href],button:not([disabled])')];const i=f.indexOf(document.activeElement);if(e.shiftKey&&i<=0||!e.shiftKey&&i===f.length-1){e.preventDefault();f[e.shiftKey?f.length-1:0].focus()}}});
$('#again').onclick=showDial;
if(document.documentElement.classList.contains('connected'))enter();else showDial();

// typewriter quote (the full quote is already in the markup and in a screen-reader-only copy)
function type(){const q=$('#qt'),s='C:\\> “'+q.dataset.quote+'”';if(calm||type.done){q.textContent=s;return}type.done=1;let i=0;q.textContent='';const t=setInterval(()=>{q.textContent=s.slice(0,++i);if(i>=s.length)clearInterval(t)},55)}

// 56K load time, from the real size of this page
$('#lt').textContent=(document.documentElement.outerHTML.length*8/53000).toFixed(1);

// ---- live widgets: /api/funk keeps the shared numbers (visitors, who's online, stirs, votes) ----
const API='/api/funk';
const ID=store.get('funk-id')||(()=>{const v=(crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2,12));store.set('funk-id',v);return v})();
let live=false;
const call=(op,extra)=>fetch(API,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({op,id:ID,...extra}),keepalive:op==='stir'}).then(r=>r.ok?r.json():Promise.reject(r.status));
const fmt=n=>Number(n).toLocaleString('en-US');

// visitor odometer
const odo=$('#odo');
function roll(to){let n=calm?to:Math.max(0,to-40);const tick=()=>{n=Math.min(to,n+Math.max(1,Math.ceil((to-n)/5)));odo.textContent=String(n).padStart(8,'0');if(n<to)setTimeout(tick,70)};tick();odo.setAttribute('aria-label','Visitor number '+fmt(to))}
function online(n){$('#online').innerHTML=n>1?`<b>★ ${fmt(n)} PEOPLE ARE BROWSING THIS PAGE RIGHT NOW (you + ${fmt(n-1)}) ★</b>`:'<b>★ 1 PERSON IS BROWSING THIS PAGE RIGHT NOW (that’s you) ★</b>'}
function offline(){live=false;odo.textContent='--------';odo.setAttribute('aria-label','Visitor counter offline');$('#since').textContent='the counter is out to lunch, back soon';$('#stc').textContent='many';drawPoll()}

// cauldron: count locally right away, send the stirs in batches
let stirs=0,pend=0,flushT;const stc=$('#stc');
const showStirs=()=>{stc.textContent=fmt(stirs)};
function flush(){if(!pend)return;const n=Math.min(25,pend);pend-=n;call('stir',{n}).then(r=>{stirs=Math.max(stirs,r.stirs+pend);showStirs()}).catch(()=>{});if(pend)flushT=setTimeout(flush,400)}
function stir(){const b=$('#stir');b.classList.remove('st');void b.offsetWidth;b.classList.add('st');if(!live){T('The pot is resting. Try again in a bit.');return}stirs++;pend++;showStirs();clearTimeout(flushT);flushT=setTimeout(flush,600)}
$('#stir').onclick=stir;$('#stir2').onclick=stir;

// poll: one vote per browser, shared results
const O=['YES','ALSO YES','EXTREMELY YES'];let V=[0,0,0],mine=null;const box=$('#opts');
function drawPoll(){const tot=V.reduce((a,b)=>a+b,0);
 if(mine===null){box.innerHTML=O.map((o,i)=>`<button type="button" data-i="${i}"${live?'':' disabled'}>${o}</button>`).join('');$('#pn').textContent=live?'Click to cast your vote!':'The ballot box is closed for now.';return}
 box.innerHTML=O.map((o,i)=>{const p=tot?Math.round(V[i]/tot*100):0;return`<div class="row"><span>${o}${i===mine?' ✓':''}</span><b>${p}%</b></div><div class="bar" data-w="${tot?V[i]/tot*100:0}"></div>`}).join('');
 $('#pn').textContent=`${fmt(tot)} vote${tot===1?'':'s'} so far. Thanks for voting!`;
 requestAnimationFrame(()=>box.querySelectorAll('.bar').forEach(b=>b.style.width=b.dataset.w+'%'))}
box.onclick=e=>{const b=e.target.closest('button');if(!b||mine!==null||!live)return;box.querySelectorAll('button').forEach(x=>x.disabled=true);
 call('vote',{choice:+b.dataset.i}).then(r=>{V=r.poll;mine=r.vote;drawPoll();T('Your vote is in. Democracy!!!')},()=>{drawPoll();T('Could not reach the ballot box. Try again.')})};

function apply(r){if(r.visitors!=null)roll(r.visitors);if(r.online)online(r.online);if(r.stirs!=null){stirs=Math.max(stirs-pend,r.stirs)+pend;showStirs()}if(r.poll)V=r.poll;if('vote' in r)mine=r.vote;
 if(r.since)$('#since').textContent='since '+new Date(r.since).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});drawPoll()}
call('visit').then(r=>{live=true;apply(r);if(r.firstVisit)T('Welcome, new visitor!!!')},offline);

// heartbeat for "browsing right now": every 30 s while the tab is visible; say bye when leaving
setInterval(()=>{if(live&&!document.hidden)call('ping').then(apply,()=>{})},30000);
document.addEventListener('visibilitychange',()=>{if(live&&!document.hidden)call('ping').then(apply,()=>{})});
addEventListener('pagehide',()=>{flush();if(live&&navigator.sendBeacon)navigator.sendBeacon(API,JSON.stringify({op:'bye',id:ID}))});
drawPoll();

// things I shipped (from the public roadmap)
{const L=['prompt-to-shop e-commerce for Mexico','an ad-funded print edition','a risk-tiered merge gate','a public roadmap, 87 initiatives deep','a retrospective the next session reads first'];let i=0;const e=$('#ship');if(!calm)setInterval(()=>{if(document.hidden)return;i=(i+1)%L.length;e.textContent=L[i]},3600)}

// weather in Mexico City, live from Open-Meteo (free, no key)
{const W={0:'clear skies',1:'mostly clear',2:'partly cloudy',3:'overcast',45:'foggy',48:'foggy',51:'drizzle',53:'drizzle',55:'drizzle',61:'rain',63:'rain',65:'heavy rain',80:'showers',81:'showers',82:'heavy showers',95:'thunderstorms',96:'thunderstorms',99:'thunderstorms'};
 fetch('https://api.open-meteo.com/v1/forecast?latitude=19.43&longitude=-99.13&current=temperature_2m,weather_code&timezone=America%2FMexico_City').then(r=>r.ok?r.json():Promise.reject()).then(r=>{const c=r.current;$('#wx').innerHTML=`<span class="big">${Math.round(c.temperature_2m)}°C</span><span class="note">${W[c.weather_code]||'weather happening'} right now</span>`},()=>{$('#wx').innerHTML='<span class="note">the weather balloon is lost</span>'})}

// copy e-mail
$('#mail').onclick=()=>{const m=$('#mail').dataset.email;(navigator.clipboard&&isSecureContext?navigator.clipboard.writeText(m):Promise.reject()).then(()=>T('Copied: '+m),()=>T(m))};
{% endraw %}
</script>
</body>
</html>
